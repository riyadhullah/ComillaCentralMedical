@{
    ViewBag.Title = "ManageUsers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center mt-4 mb-4">Manage Users</h2>

<div class="mb-3 d-flex justify-content-between">
    <div style="width: 300px;">
        <input type="text" id="searchBox" class="form-control" placeholder="Search by name or phone..." />
    </div>
    <div>
        @Html.ActionLink("Create New", "CreateUsers", null, new { @class = "btn btn-success" })
        <a class="btn btn-secondary" href="@Url.Action("Dashboard", "AdminDashboard")">Back</a>
    </div>
</div>

<hr />

<div id="userTableContainer">
    @Html.Partial("_UserTable", new List<ComillaCentralMedical.Models.User>())
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Initial load
            loadUsers('');

            // Search on keyup
            $('#searchBox').on('keyup', function () {
                let query = $(this).val();
                loadUsers(query);
            });

            function loadUsers(searchTerm) {
                $.ajax({
                    url: '@Url.Action("SearchUsers", "ManageUsers")',
                    type: 'GET',
                    data: { search: searchTerm },
                    success: function (result) {
                        $('#userTableContainer').html(result);
                    },
                    error: function () {
                        $('#userTableContainer').html('<p class="text-danger">Failed to load users.</p>');
                    }
                });
            }
        });
    </script>
}
