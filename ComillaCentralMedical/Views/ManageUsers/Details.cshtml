@model ComillaCentralMedical.Models.User

@{
    ViewBag.Title = "User Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center my-4">User Profile</h2>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @Html.Partial("_UserProfile", Model)
            <div class="text-end mt-3">
                <a class="btn btn-primary" href="@Url.Action("EditUser", "ManageUsers", new { id = Model.ID })">Edit</a>
                <a class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this user?');" href="@Url.Action("Delete", "ManageUsers", new { id = Model.ID })">Delete</a>
                <a class="btn btn-secondary" href="@Url.Action("ManageUsers", "ManageUsers")">Back</a>
            </div>
        </div>
    </div>
</div>

@section PageSpecificButton {
    <a href="@Url.Action("CreateUsers", "ManageUsers")" class="btn btn-primary">Create New User</a>
    <a href="@Url.Action("ManageUsers", "ManageUsers")" class="btn btn-primary">Manage Users</a>
}