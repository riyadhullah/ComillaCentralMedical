@model List<ComillaCentralMedical.Models.Bill>

@{
    ViewBag.Title = "Pending Bills";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="align-middle">
            <h2 class="text-primary text-center">Pending Bills</h2>
        </div>
    </div>

    <div class="row mb-3 justify-content-between">
        <div class="col-md-4">
            <input type="text" id="billSearchBox" class="form-control" placeholder="Search by patient name or phone..." />
        </div>
        <div class="col-md-auto text-end">
            @Html.ActionLink("Accountant Summary", "Report", "Accountant", null, new { @class = "btn btn-success" })
        </div>
    </div>

    <div id="billList">
        @Html.Partial("_PendingBillTable", Model)
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#billSearchBox').on('keyup', function () {
                let query = $(this).val();

                $.ajax({
                    url: '@Url.Action("SearchPendingBills", "Accountant")',
                    type: 'GET',
                    data: { search: query },
                    success: function (result) {
                        $('#billList').html(result);
                    },
                    error: function () {
                        alert("Failed to search bills.");
                    }
                });
            });
        });
    </script>
}
