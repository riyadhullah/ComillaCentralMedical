@model List<ComillaCentralMedical.Models.Bill>
@{
    ViewBag.Title = "Pending Bills";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="align-middle">
            <h2 class="text-primary text-center">Pending Bills</h2>
        </div>
    </div>

    <!-- Search + Button -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <input type="text" id="searchBox" class="form-control w-25" placeholder="Search by name or phone..." />
        @Html.ActionLink("Accountant Summary", "Report", "Accountant", null, new { @class = "btn btn-success" })
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div id="pendingBillTable">
        @Html.Partial("_PendingBillTable", Model)
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#searchBox').on('keyup', function () {
                var query = $(this).val();

                $.ajax({
                    url: '@Url.Action("SearchPendingBills", "Accountant")',
                    type: 'GET',
                    data: { search: query },
                    success: function (result) {
                        $('#pendingBillTable').html(result);
                    },
                    error: function () {
                        alert("Search failed.");
                    }
                });
            });
        });
    </script>
}

@section PageSpecificButton {
    <a href="@Url.Action("Report", "Accountant")" class="btn btn-primary ">Accountant Summary</a>
    <a href="@Url.Action("Pending", "Accountant")" class="btn btn-primary">Pending Bills</a>
}
