@model ComillaCentralMedical.Models.Bill

@{
    Layout = null; // No layout for clean print
    string filename = $"{Model.BillID}_{Model.PatientName}".Replace(" ", "_");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@filename</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            font-size: 14px;
            margin: 20px;
        }

        .invoice-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .invoice-section {
            margin-bottom: 20px;
        }

        .table th, .table td {
            vertical-align: middle;
        }

        @@media print {
            @@page {
                margin: 20mm;
            }
        }
    </style>
</head>
<body onload="window.print()">

    <div class="container mt-4">
        <div class="invoice-header">
            <h2>Comilla Central Medical</h2>
            <p class="text-muted">Patient Invoice</p>
            <hr />
        </div>

        <div class="invoice-section">
            <strong>Bill ID:</strong> @Model.BillID<br />
            <strong>Patient Name:</strong> @Model.PatientName<br />
            <strong>Phone:</strong> @Model.Phone<br />
            <strong>Created At:</strong> @Model.CreatedAt.ToString("dd MMM yyyy hh:mm tt")<br />
            <strong>Created By:</strong> @Model.CreatedBy<br />
            <strong>Confirmed:</strong> @(Model.IsConfirmed ? "Yes" : "No")
        </div>

        <div class="invoice-section">
            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Service</th>
                        <th>Category</th>
                        <th>Unit Type</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Discount (%)</th>
                        <th>Line Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.BillItems)
                    {
                        <tr>
                            <td>@(item.Service?.ServiceName ?? "N/A")</td>
                            <td>@(item.Service?.Category ?? "N/A")</td>
                            <td>@(item.Service?.UnitType ?? "N/A")</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice.ToString("F2") Tk</td>
                            <td>@(item.Service?.DiscountRate?.ToString("0") ?? "0")%</td>
                            <td>@((item.UnitPrice * item.Quantity * (1 - (item.Service?.DiscountRate ?? 0) / 100)).ToString("F2")) Tk</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="invoice-section text-end">
            <p><strong>Overall Discount:</strong> @((Model.OverallDiscountRate ?? 0).ToString("0"))%</p>
            <p><strong>Total Amount:</strong> @((Model.TotalAmount.HasValue ? Model.TotalAmount.Value.ToString("F2") : "0.00")) Tk</p>
        </div>

        <footer class="text-center mt-5 text-muted">
            <small>Thank you for visiting Comilla Central Medical.</small>
        </footer>
    </div>

    <script>
        window.onload = function () {
            window.print();
        };

        window.onafterprint = function () {
            window.location.href = '@Url.Action("Report", "Accountant", new { id = Model.BillID })';
        };
    </script>
</body>
</html>
