@model ComillaCentralMedical.Models.AccountantSummary

@{
    ViewBag.Title = "Accountant Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h1 class="text-center text-primary mb-4">Accountant Summary</h1>

    <!-- Summary Cards -->
    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="card border-primary shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Bills Confirmed Today</h5>
                    <p class="display-5 text-primary">@Model.ConfirmedTodayCount</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card border-success shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Income Today</h5>
                    <p class="display-5 text-success">@Model.TotalIncomeToday.ToString("F2") Tk</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-info shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Income This Month</h5>
                    <p class="display-5 text-info">@Model.TotalIncomeThisMonth.ToString("F2") Tk</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Bills Table -->
    <div class="mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="text-secondary mb-0">Bills Confirmed Today</h2>
            @Html.ActionLink("Pending Bills", "Pending", "Accountant", null, new { @class = "btn btn-success" })
        </div>
        <div class="table-responsive shadow-sm">
            <table class="table table-hover table-bordered">
                <thead class="table-primary text-center">
                    <tr>
                        <th>Bill ID</th>
                        <th>Patient Name</th>
                        <th>Phone</th>
                        <th>Total Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Bills.Any())
                    {
                        foreach (var bill in Model.Bills)
                        {
                            <tr>
                                <td class="text-center">@bill.BillID</td>
                                <td class="text-center">@bill.PatientName</td>
                                <td class="text-center">@bill.Phone</td>
                                <td class="text-center">@(bill.TotalAmount?.ToString("F2") ?? "N/A") Tk</td>
                                <td class="text-center">
                                    @Html.ActionLink("Details", "Details", "Accountant",
                                           new { id = bill.BillID },
                                           new { @class = "btn btn-info btn-sm" })
                                    @using (Html.BeginForm("Print", "Accountant", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.Hidden("id", bill.BillID)
                                        <button type="submit" class="btn btn-success btn-sm" onclick="return Print('Print this bill?');">Print</button>
                                    }

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">No bills confirmed today.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
