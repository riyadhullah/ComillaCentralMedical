@model List<ComillaCentralMedical.Models.Bill>

@{
    ViewBag.Title = "Accountant Report";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var todayBills = Model.Where(b => b.ConfirmedAt?.Date == DateTime.Today).ToList();
    var monthBills = Model.Where(b => b.ConfirmedAt?.Month == DateTime.Today.Month && b.ConfirmedAt?.Year == DateTime.Today.Year).ToList();

    var confirmedTodayCount = todayBills.Count;
    var totalIncomeToday = todayBills.Sum(b => b.TotalAmount ?? 0);
    var totalIncomeMonth = monthBills.Sum(b => b.TotalAmount ?? 0);
}

<div class="container mt-5">
    <h1 class="text-center text-primary mb-4">Accountant Summary</h1>

    <!-- Summary Cards -->
    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="card border-primary shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Bills Confirmed Today</h5>
                    <p class="display-5 text-primary">@confirmedTodayCount</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card border-success shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Income Today</h5>
                    <p class="display-5 text-success">@totalIncomeToday.ToString("F2") Tk</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card border-info shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Income This Month</h5>
                    <p class="display-5 text-info">@totalIncomeMonth.ToString("F2") Tk</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Search + Tabs -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <input type="text" id="billSearchBox" class="form-control w-25" placeholder="Search by name or phone..." />
        @Html.ActionLink("Pending Bills", "Pending", "Accountant", null, new { @class = "btn btn-success" })
    </div>

    <ul class="nav nav-tabs mb-3" id="confirmedTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" id="today-tab" data-bs-toggle="tab" data-bs-target="#today" type="button" role="tab">Today</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="month-tab" data-bs-toggle="tab" data-bs-target="#month" type="button" role="tab">This Month</button>
        </li>
    </ul>

    <div class="tab-content" id="confirmedTabsContent">
        <div class="tab-pane fade show active" id="today" role="tabpanel">
            <div id="todayContent">
                @Html.Partial("_ConfirmedBillTable", todayBills)
            </div>
        </div>
        <div class="tab-pane fade" id="month" role="tabpanel">
            <div id="monthContent">
                @Html.Partial("_ConfirmedBillTable", monthBills)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#billSearchBox').on('keyup', function () {
                let query = $(this).val();
                let activeTab = $('.nav-tabs .nav-link.active').attr('id');
                let scope = activeTab === 'month-tab' ? 'month' : 'today';

                $.ajax({
                    url: '@Url.Action("SearchConfirmedBills", "Accountant")',
                    type: 'GET',
                    data: { search: query, scope: scope },
                    success: function (result) {
                        if (scope === 'month') {
                            $('#monthContent').html(result);
                        } else {
                            $('#todayContent').html(result);
                        }
                    },
                    error: function () {
                        alert("Search failed. Please try again.");
                    }
                });
            });
        });
    </script>
}
