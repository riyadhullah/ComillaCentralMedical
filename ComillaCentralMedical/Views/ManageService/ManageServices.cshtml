@model IEnumerable<ComillaCentralMedical.Models.Service>

@{
    ViewBag.Title = "Manage Services";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center mt-4 mb-4">Manage Services</h2>

<div class="d-flex justify-content-between mb-3">
    <input type="text" id="searchBox" class="form-control w-25" placeholder="Search services..." />
    @Html.ActionLink("Create New Service", "CreateService", "ManageService", null, new { @class = "btn btn-success" })
</div>

<hr />

<div id="serviceTable">
    @Html.Partial("_ServiceTable", Model)
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#searchBox').on('keyup', function () {
                var query = $(this).val();

                $.ajax({
                    url: '@Url.Action("SearchServices", "ManageService")',
                    type: 'GET',
                    data: { search: query },
                    success: function (result) {
                        $('#serviceTable').html(result);
                    },
                    error: function () {
                        alert("Search failed.");
                    }
                });
            });
        });
    </script>
}


@section PageSpecificButton {
    <a href="@Url.Action("CreateService", "ManageService")" class="btn btn-primary">Create New Service</a>
    <a href="@Url.Action("ManageServices", "ManageService")" class="btn btn-primary">Manage Services</a>
}