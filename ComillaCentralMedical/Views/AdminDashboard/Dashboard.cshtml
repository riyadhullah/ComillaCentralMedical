@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var todayBills = ViewBag.RecentActivities as List<ComillaCentralMedical.Models.Bill>;
}

<div class="container py-5">
    <!-- Overview Cards -->
    <div class="row text-center mb-5">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-gradient-primary text-white">
                <div class="card-body">
                    <i class="bi bi-people-fill display-4"></i>
                    <h5 class="card-title mt-3">Today Invoices</h5>
                    <p class="display-4 fw-bold">
                        @(ViewBag.TodayInvoices != null ? ViewBag.TodayInvoices.Count : 0)
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-gradient-success text-white">
                <div class="card-body">
                    <i class="bi bi-receipt-cutoff display-4"></i>
                    <h5 class="card-title mt-3">Total Invoices</h5>
                    <p class="display-4 fw-bold">@ViewBag.TotalInvoices</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-gradient-warning text-white">
                <div class="card-body">
                    <i class="bi bi-cash-coin display-4"></i>
                    <h5 class="card-title mt-3">Total Income</h5>
                    <p class="display-4 fw-bold">৳ @ViewBag.TotalIncome.ToString("N2")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activities -->
    <div class="mb-5">
        <h4 class="text-secondary mb-3">Recent Activities</h4>

        @if (todayBills != null && todayBills.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-secondary">
                        <tr>
                            <th>Bill ID</th>
                            <th>Patient Name</th>
                            <th>Phone</th>
                            <th>Total (৳)</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th>Created By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bill in todayBills)
                        {
                            string status;
                            string statusClass;

                            if (bill.IsReturned)
                            {
                                status = "Returned";
                                statusClass = "text-danger";
                            }
                            else if (bill.IsConfirmed)
                            {
                                status = "Confirmed";
                                statusClass = "text-success";
                            }
                            else
                            {
                                status = "Pending";
                                statusClass = "text-warning";
                            }

                            <tr>
                                <td>#@bill.BillID</td>
                                <td>@bill.PatientName</td>
                                <td>@bill.Phone</td>
                                <td>@string.Format("{0:N2}", bill.TotalAmount)</td>
                                <td class="@statusClass fw-bold">@status</td>
                                <td>@bill.CreatedAt.ToString("hh:mm tt")</td>
                                <td>@bill.CreatedBy</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p>No bills created today.</p>
        }
    </div>


    <!-- Quick Links -->
    <div class="mb-4">
        <h4 class="text-secondary mb-3">Quick Links</h4>
        <div class="d-flex flex-wrap gap-3">
            <a href="@Url.Action("ManageUsers", "ManageUsers")" class="btn btn-lg btn-outline-primary d-flex align-items-center">
                <i class="bi bi-people me-2"></i> Manage Users
            </a>
            <a href="@Url.Action("ManageServices", "ManageService")" class="btn btn-lg btn-outline-success d-flex align-items-center">
                <i class="bi bi-tools me-2"></i> Manage Services
            </a>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(45deg, #007bff, #0056b3);
    }

    .bg-gradient-success {
        background: linear-gradient(45deg, #28a745, #196f3d);
    }

    .bg-gradient-warning {
        background: linear-gradient(45deg, #ffc107, #d39e00);
    }

    .btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
    }
</style>

@section PageSpecificButton {
    <a href="@Url.Action("ManageUsers", "ManageUsers")" class="btn btn-primary">Manage Users</a>
    <a href="@Url.Action("ManageServices", "ManageService")" class="btn btn-primary">Manage Services</a>
}
