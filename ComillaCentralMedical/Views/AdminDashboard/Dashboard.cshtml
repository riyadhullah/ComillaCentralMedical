@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var todayBills = ViewBag.RecentActivities as List<dynamic>;
}

<div class="container py-5">
    <!-- Overview Cards -->
    <div class="row text-center mb-5">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-gradient-primary text-white">
                <div class="card-body">
                    <i class="bi bi-people-fill display-4"></i>
                    <h5 class="card-title mt-3">Today Invoices</h5>
                    <p class="display-4 fw-bold">
                        @if (ViewBag.TodayInvoices != null)
                        {
                            @ViewBag.TodayInvoices.Count
                        }
                        else
                        {
                            @:0
                        }
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-gradient-success text-white">
                <div class="card-body">
                    <i class="bi bi-receipt-cutoff display-4"></i>
                    <h5 class="card-title mt-3">Total Invoices</h5>
                    <p class="display-4 fw-bold">@ViewBag.TotalInvoices</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-gradient-warning text-white">
                <div class="card-body">
                    <i class="bi bi-cash-coin display-4"></i>
                    <h5 class="card-title mt-3">Total Income</h5>
                    <p class="display-4 fw-bold">৳ @ViewBag.TotalIncome.ToString("N2")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activities -->
    <div class="mb-5">
        <h4 class="text-secondary mb-3">Recent Activities</h4>
        @if (todayBills != null && todayBills.Count > 0)
        {
            <ul class="list-group">
                @foreach (var bill in todayBills)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Bill #@bill.BillID for <strong>@bill.PatientName</strong> — ৳ @string.Format("{0:N2}", bill.TotalAmount)
                        <span class="text-muted">@bill.CreatedAt.ToString("hh:mm tt")</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>No bills created today.</p>
        }
    </div>

    <!-- Quick Links -->
    <div class="mb-4">
        <h4 class="text-secondary mb-3">Quick Links</h4>
        <div class="d-flex flex-wrap gap-3">
            <a href="@Url.Action("ManageUsers", "ManageUsers")" class="btn btn-lg btn-outline-primary d-flex align-items-center">
                <i class="bi bi-people me-2"></i> Manage Users
            </a>
            <a href="@Url.Action("ManageServices", "ManageServices")" class="btn btn-lg btn-outline-success d-flex align-items-center">
                <i class="bi bi-tools me-2"></i> Manage Services
            </a>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(45deg, #007bff, #0056b3);
    }

    .bg-gradient-success {
        background: linear-gradient(45deg, #28a745, #196f3d);
    }

    .bg-gradient-warning {
        background: linear-gradient(45deg, #ffc107, #d39e00);
    }

    .timeline {
        list-style: none;
        padding: 0;
    }

    .timeline-item {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

    .timeline-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        margin-right: 15px;
    }

    .timeline-content {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        flex-grow: 1;
    }

    .btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
    }
</style>
@section PageSpecificButton {
    <a href="@Url.Action("ManageUsers", "ManageUsers")" class="btn btn-primary">Manage Users</a>
    <a href="@Url.Action("ManageServices", "ManageServices")" class="btn btn-primary">Manage Services</a>
}
