@model List<ComillaCentralMedical.Models.Bill>

@{
    ViewBag.Title = "All Bills";
    var pendingBills = Model.Where(b => !b.IsConfirmed).ToList();
    var confirmedBills = Model.Where(b => b.IsConfirmed).ToList();
}

<h2 class="mb-4 text-center text-primary">All Bills</h2>

<!-- Search and Button -->
<div class="mb-3 d-flex justify-content-between">
    <input type="text" id="billSearchBox" class="form-control w-25" placeholder="Search by patient name or phone..." />
    <a href="@Url.Action("Create", "Receptionist")" class="btn btn-success">Create New Bill</a>
</div>

<!-- Bootstrap Tabs -->
<ul class="nav nav-tabs mb-3" id="billTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">Pending Bills</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="confirmed-tab" data-bs-toggle="tab" data-bs-target="#confirmed" type="button" role="tab">Confirmed Bills</button>
    </li>
</ul>

<!-- Tab Content -->
<div class="tab-content" id="billTabsContent">
    <div class="tab-pane fade show active" id="pending" role="tabpanel">
        <div id="pendingContent">
            @Html.Partial("_BillTable", pendingBills)
        </div>
    </div>
    <div class="tab-pane fade" id="confirmed" role="tabpanel">
        <div id="confirmedContent">
            @Html.Partial("_BillTable", confirmedBills)
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#billSearchBox').on('keyup', function () {
                const query = $(this).val();
                const activeTab = $('.nav-tabs .nav-link.active').attr('id');
                const isConfirmed = activeTab === 'confirmed-tab';

                $.ajax({
                    url: '@Url.Action("SearchBills", "Receptionist")',
                    type: 'GET',
                    data: { search: query, confirmed: isConfirmed },
                    success: function (result) {
                        if (isConfirmed)
                            $('#confirmedContent').html(result);
                        else
                            $('#pendingContent').html(result);
                    },
                    error: function () {
                        alert("Failed to search bills.");
                    }
                });
            });
        });
    </script>
}

@section PageSpecificButton {
    <a href="@Url.Action("Create", "Receptionist")" class="btn btn-primary">Create Bill</a>
    <a href="@Url.Action("Index", "Receptionist")" class="btn btn-primary">All Bills</a>
}
