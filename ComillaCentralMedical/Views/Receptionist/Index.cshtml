@model List<ComillaCentralMedical.Models.Bill>

@{
    ViewBag.Title = "All Bills";
    var pendingBills = Model.Where(b => !b.IsConfirmed).ToList();
    var confirmedBills = Model.Where(b => b.IsConfirmed).ToList();
}

<h2 class="mb-4">All Bills</h2>

<div class="mb-3">
    <a href="@Url.Action("Create", "Receptionist")" class="btn btn-success">Create New Bill</a>
</div>


<!-- Bootstrap Tabs -->
<ul class="nav nav-tabs mb-3" id="billTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">Pending Bills</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="confirmed-tab" data-bs-toggle="tab" data-bs-target="#confirmed" type="button" role="tab">Confirmed Bills</button>
    </li>
</ul>

<!-- Tab Content -->
<div class="tab-content" id="billTabsContent">
    <div class="tab-pane fade show active" id="pending" role="tabpanel">
        @Html.Partial("_BillTable", pendingBills)
    </div>
    <div class="tab-pane fade" id="confirmed" role="tabpanel">
        @Html.Partial("_BillTable", confirmedBills)
    </div>
</div>
