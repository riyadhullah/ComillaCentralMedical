@model ComillaCentralMedical.Models.Bill

@{
    ViewBag.Title = "Delete Bill";
}

<div class="container mt-5">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Delete Confirmation</h3>
        </div>
        <div class="card-body">
            <p class="text-danger fw-bold">Are you sure you want to delete this bill?</p>
            <dl class="row">
                <dt class="col-sm-4">Bill ID</dt>
                <dd class="col-sm-8">@Model.BillID</dd>

                <dt class="col-sm-4">Patient Name</dt>
                <dd class="col-sm-8">@Model.PatientName</dd>

                <dt class="col-sm-4">Phone</dt>
                <dd class="col-sm-8">@Model.Phone</dd>

                <dt class="col-sm-4">Total Amount</dt>
                <dd class="col-sm-8">@($"{(Model.TotalAmount ?? 0).ToString("F2")} Tk")</dd>

                <dt class="col-sm-4">Overall Discount</dt>
                <dd class="col-sm-8">@($"{(Model.OverallDiscountRate ?? 0).ToString("0")}%")</dd>

                <dt class="col-sm-4">Confirmed</dt>
                <dd class="col-sm-8">@((Model.IsConfirmed) ? "Yes" : "No")</dd>

                <dt class="col-sm-4">Created At</dt>
                <dd class="col-sm-8">@Model.CreatedAt.ToString("f")</dd>
            </dl>

            @using (Html.BeginForm("Delete", "Receptionist", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.BillID)

                <div class="mt-4">
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    <a href="@Url.Action("Index", "Receptionist")" class="btn btn-secondary">Cancel</a>
                </div>
            }
        </div>
    </div>
</div>
