@model ComillaCentralMedical.Models.Bill

@{
    ViewBag.Title = "Delete Bill";
}

<h2 class="text-danger">Delete Confirmation</h2>

<h4>Are you sure you want to delete this bill?</h4>
<hr />

<div class="mb-3">
    <strong>Patient Name:</strong> @Model.PatientName
</div>
<div class="mb-3">
    <strong>Phone:</strong> @Model.Phone
</div>
<div class="mb-3">
    <strong>Total Amount:</strong> @Model.TotalAmount
</div>
<div class="mb-3">
    <strong>Discount Rate:</strong> @Model.OverallDiscountRate%
</div>
<div class="mb-3">
    <strong>Confirmed:</strong> @(Model.IsConfirmed ? "Yes" : "No")
</div>
<div class="mb-3">
    <strong>Created At:</strong> @Model.CreatedAt.ToString("f")
</div>

@using (Html.BeginForm("Delete", "Receptionist", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.BillID)

    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a href="@Url.Action("Index", "Receptionist")" class="btn btn-secondary">Cancel</a>
}
