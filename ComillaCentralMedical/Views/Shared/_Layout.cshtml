<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Comilla Central Medical</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        /* Navbar customizations */
        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
            letter-spacing: 1px;
        }

        .nav-link {
            font-weight: 600;
            font-size: 1.05rem;
            transition: color 0.3s ease;
        }

            .nav-link:hover, .nav-link:focus {
                color: #ff6f61 !important;
                text-decoration: underline;
            }

        /* Footer */
        footer {
            background-color: #f8f9fa;
            font-size: 0.9rem;
            color: #555;
        }


        .custom-heading {
            display: flex;
            justify-content: center;
            align-items: center;
            white-space: nowrap;
            overflow: hidden;
            padding:5px;
            text-overflow: ellipsis;
            font-size: 1.2rem; /* Adjust size as needed */
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">Comilla Central Medical</a>
            <div class="container my-3 text-left ">
                @RenderSection("PageSpecificButton", required: false)
            </div>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @if (Session["UserId"] != null)
                    {
                        <h6 class="custom-heading">Welcome, @Session["FullName"]</h6>
                        <li class="nav-item">
                            <a class="btn btn-danger" href="/User/Logout">Logout</a>
                        </li>

                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-info" href="/User/Login">Login</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main role="main" class="container my-5">
        <!-- container my-5 Bootstrap Framwork -->
        @RenderBody()
    </main>

    <footer class="py-3 text-center">
        <div class="container">
            &copy; @DateTime.Now.Year Comilla Central Medical.
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
    
</body>
</html>
